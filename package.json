{
  "name": "@ali-hajeh/response-handler",
  "version": "0.0.4",
  "description": "A package to help organize responses from your Express.js API",
  "keywords": [
    "express",
    "api",
    "response",
    "handler",
    "typescript"
  ],
  "homepage": "https://github.com/ali-hajeh/response-handler",
  "license": "ISC",
  "author": "ali-hajeh",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "typings": "dist/index",
  "exports": {
    ".": {
      "require": "./dist/index.js",
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "directories": {
    "test": "test"
  },
  "files": [
    "dist/**/*",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "ts-node-dev src/index.ts",
    "test": "jest",
    "clean": "rm -rf dist",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "lint": "prettier --check \"src/**/*.{ts,tsx}\"",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "jest": "^29.7.0",
    "joi": "^17.13.3",
    "prettier": "^2.8.8",
    "ts-jest": "^29.2.5",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.5"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node"
  },
  "publishConfig": {
    "access": "public"
  }
}
